# Copy this file to .env and fill in your keys.
# The app works even with NO keys set (falls back to rule-based extraction),
# but for the demo you'll want at least one LLM provider working.

# Primary extraction model
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback provider if Gemini is rate-limited / unavailable (429, etc.)
GROQ_API_KEY=your_groq_api_key_here
